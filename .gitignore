# =============================================================================
# Git Ignore Rules for Large Files, Virtual Environments & Local Caches
# =============================================================================

# Virtual Environment (GitHub should never track virtualenvs: ~950 MB, 28,000+ files)
.venv/
venv/
ENV/
env/

# Python compiled bytecode & runtime artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Multi-Gigabyte Raw & Test Datasets (exceeds GitHub's 100 MB hard file limit)
dataset/test/*.tsv
dataset/train/*.tsv
dataset/*.tsv
*.tsv.gz
*.zip
*.tar.gz

# Large Output Submissions (>50 MB to 400 MB)
output/*.tsv

# Temporary Scratch Files & Logs
*.log
*.tmp
*.bak
*.swp
scratch/test_*.py


output_predictions_proof.zip
demo_sample/

Business-entity-resolution/

scratch/


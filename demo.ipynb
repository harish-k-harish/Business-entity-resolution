 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Multi-Source Business Entity Resolution: Live Interactive Demo\n",
    "\n",
    "This notebook demonstrates the end-to-end entity matching pipeline directly in your browser:\n",
    "1. **Pre-processing & NFKD Unicode Normalization** (`src/normalize.py`)\n",
    "2. **BM25-IDF Multi-Field Inverted Index Blocking** (`src/blocking.py`)\n",
    "3. **11-Dimensional Pairwise Feature Extraction** (`src/features.py`)\n",
    "4. **Trained LightGBM Classifier Prediction & Thresholding ($\\tau^* = 0.74$)** (`src/model.py`)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Install lightweight dependencies\n",
    "!pip install rapidfuzz lightgbm pandas numpy -q\n",
    "\n",
    "import sys\n",
    "import os\n",
    "import pickle\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Add source directory to path\n",
    "sys.path.append('code/business_entity_resolution/src')\n",
    "from normalize import normalize_text\n",
    "from blocking import CountryInvertedBlocker\n",
    "from features import extract_pair_features, FEATURE_NAMES"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Load trained model and hyperparameter metadata\n",
    "model_path = 'code/business_entity_resolution/models/matcher_model.pkl'\n",
    "meta_path = 'code/business_entity_resolution/models/model_meta.pkl'\n",
    "\n",
    "with open(model_path, 'rb') as f:\n",
    "    model = pickle.load(f)\n",
    "with open(meta_path, 'rb') as f:\n",
    "    meta = pickle.load(f)\n",
    "\n",
    "threshold = meta.get('optimal_threshold', 0.74)\n",
    "print(f\"Loaded LightGBM model successfully!\")\n",
    "print(f\"Calibrated Optimal Decision Threshold (tau*): {threshold:.2f}\")\n",
    "print(f\"Feature Count: {len(FEATURE_NAMES)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Load Sample Multi-Source Records\n",
    "df_s1 = pd.read_csv('demo_sample/sample_source1.tsv', sep='\\t')\n",
    "df_s2 = pd.read_csv('demo_sample/sample_source2.tsv', sep='\\t')\n",
    "df_s3 = pd.read_csv('demo_sample/sample_source3.tsv', sep='\\t')\n",
    "df_targets = pd.concat([df_s2, df_s3], ignore_index=True)\n",
    "\n",
    "print(f\"Sample Reference Entities (Source 1): {len(df_s1)}\")\n",
    "print(f\"Sample Candidate Pool (Sources 2 & 3): {len(df_targets)}\")\n",
    "df_s1[['entity_id', 'business_name', 'business_address', 'country']].head(3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4. High-Speed Preprocessing\n",
    "df_s1['norm_name'] = df_s1['business_name'].astype(str).apply(normalize_text)\n",
    "df_s1['norm_addr'] = df_s1['business_address'].astype(str).apply(normalize_text)\n",
    "\n",
    "df_targets['norm_name'] = df_targets['business_name'].astype(str).apply(normalize_text)\n",
    "df_targets['norm_addr'] = df_targets['business_address'].astype(str).apply(normalize_text)\n",
    "\n",
    "print(\"Sample Normalized Record:\")\n",
    "print(\"  Raw Name:       \", df_s1['business_name'].iloc[0])\n",
    "print(\"  Normalized Name:\", df_s1['norm_name'].iloc[0])\n",
    "print(\"  Normalized Addr:\", df_s1['norm_addr'].iloc[0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5. BM25-IDF Blocking & Candidate Retrieval\n",
    "blocker = CountryInvertedBlocker(top_k=10, max_postings=1000, top_tokens_per_field=4)\n",
    "blocker.fit_targets(\n",
    "    target_ids=df_targets['entity_id'].values,\n",
    "    target_norm_names=df_targets['norm_name'].tolist(),\n",
    "    target_norm_addrs=df_targets['norm_addr'].tolist()\n",
    ")\n",
    "\n",
    "cands_dict, scores_dict = blocker.query_batch(\n",
    "    query_ids=df_s1['entity_id'].tolist(),\n",
    "    query_norm_names=df_s1['norm_name'].tolist(),\n",
    "    query_norm_addrs=df_s1['norm_addr'].tolist()\n",
    ")\n",
    "\n",
    "print(f\"Blocking Complete! Extracted candidates for {len(cands_dict)} reference entities.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6. 11-Dimensional Feature Extraction & Matcher Inference\n",
    "results = []\n",
    "tgt_map = df_targets.set_index('entity_id').to_dict('index')\n",
    "\n",
    "for _, row in df_s1.iterrows():\n",
    "    s1_id = row['entity_id']\n",
    "    q_name = row['norm_name']\n",
    "    q_addr = row['norm_addr']\n",
    "    candidates = cands_dict.get(s1_id, [])\n",
    "    cand_scores = scores_dict.get(s1_id, [])\n",
    "    \n",
    "    matched_ids = []\n",
    "    for tid, b_score in zip(candidates, cand_scores):\n",
    "        if tid in tgt_map:\n",
    "            t_name = tgt_map[tid]['norm_name']\n",
    "            t_addr = tgt_map[tid]['norm_addr']\n",
    "            feats = extract_pair_features(q_name, q_addr, t_name, t_addr, b_score)\n",
    "            prob = model.predict_proba([feats])[0, 1]\n",
    "            if prob >= threshold:\n",
    "                matched_ids.append((tid, prob))\n",
    "                \n",
    "    results.append({\n",
    "        'Source1_ID': s1_id,\n",
    "        'Business_Name': row['business_name'],\n",
    "        'Address': row['business_address'],\n",
    "        'Resolved_Matches': [m[0] for m in matched_ids],\n",
    "        'Status': 'MATCHED' if matched_ids else 'SINGLETON'\n",
    "    })\n",
    "\n",
    "df_res = pd.DataFrame(results)\n",
    "print(\"\\n--- ENTITY RESOLUTION RESULTS ---\")\n",
    "df_res[['Source1_ID', 'Business_Name', 'Status', 'Resolved_Matches']].head(10)"
   ]
  }
 ]
}
